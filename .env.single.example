# =============================================================================
# n8n SINGLE — zmienne dla docker-compose.single.yaml
# =============================================================================
# 1. cp .env.single.example .env.single
# 2. Uzupełnij CHANGE_ME
# 3. docker compose -f docker-compose.single.yaml --env-file .env.single up -d
# =============================================================================

# --- Domena (jeden zwykły rekord A: szkolenie-n8n.easyautomate.pl -> IP) ------
# NIE potrzebujesz wildcard — to pojedynczy host. SSL wystawi nginx-proxy-manager.
N8N_HOST=szkolenie-n8n.easyautomate.pl

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n

# --- Klucz szyfrowania n8n ----------------------------------------------------
# Wygeneruj RAZ i NIE zmieniaj (inaczej stracisz dostęp do zapisanych danych):
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=CHANGE_ME

# --- Strefa czasowa -----------------------------------------------------------
GENERIC_TIMEZONE=Europe/Warsaw

# --- SMTP (opcjonalnie) — zapraszanie użytkowników e-mailem -------------------
# Bez SMTP też dodasz użytkowników: n8n pokaże link zaproszenia do skopiowania.
# Z SMTP zaproszenia idą mailem. Odkomentuj i uzupełnij:
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.twojdostawca.pl
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=CHANGE_ME
# N8N_SMTP_PASS=CHANGE_ME
# N8N_SMTP_SENDER=n8n@easyautomate.pl
# N8N_SMTP_SSL=false

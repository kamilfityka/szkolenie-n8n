# =============================================================================
# n8n FLEET (dynamiczna) — konfiguracja bazowa
# =============================================================================
# 1. Skopiuj:   cp .env.dynamic.example .env.dynamic
# 2. Uzupełnij wartości CHANGE_ME oraz BASE_DOMAIN / ACME_EMAIL
# 3. Sprawdź serwer:      bash preflight.sh user{1..20}
# 4. Dodawaj instancje:   bash add-instance.sh user1
# =============================================================================

# --- Domena bazowa ------------------------------------------------------------
# Instancje powstają jako subdomeny: <nazwa>.<BASE_DOMAIN>
# Przykład: BASE_DOMAIN=n8n.easyautomate.pl  ->  user1.n8n.easyautomate.pl
# WYMAGANE w DNS: rekord A na każdą subdomenę (user1..userN) wskazujący na IP
# serwera, albo jeden wildcard:  *.n8n  A  <IP_SERWERA>
BASE_DOMAIN=n8n.easyautomate.pl

# --- E-mail do Let's Encrypt --------------------------------------------------
# Na ten adres Let's Encrypt wyśle ostrzeżenia o wygasających certyfikatach.
ACME_EMAIL=CHANGE_ME@example.com

# --- nginx-proxy-manager ------------------------------------------------------
# NPM trzyma porty 80/443, robi SSL i kieruje ruch po nazwie domeny wprost do
# kontenera uczestnika:   user1.<BASE_DOMAIN>  ->  n8n-user1:5678
# Instancje n8n dołączają do SIECI, w której stoi NPM (sieć zewnętrzna, tworzy
# ją compose NPM-a). Sprawdź jej nazwę:  docker network ls
NPM_NETWORK=nginx-proxy-manager_default

# Nazwa kontenera NPM — puste = wykrywane automatycznie po nazwie obrazu.
# Używane tylko do podpowiedzi i diagnostyki.
NPM_CONTAINER=

# Dostęp do API NPM — potrzebny tylko dla `bash npm-hosts.sh --create`,
# czyli hurtowego zakładania Proxy Hostów. Bez tego wpiszesz je ręcznie w panelu.
NPM_URL=http://127.0.0.1:81
NPM_EMAIL=CHANGE_ME@example.com
NPM_PASSWORD=CHANGE_ME

# --- PostgreSQL (współdzielony dla całej floty) -------------------------------
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=CHANGE_ME

# Użytkownik n8n w PostgreSQL (wspólny; każda instancja ma OSOBNĄ bazę) --------
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=CHANGE_ME

# --- Obraz n8n i kanał push ----------------------------------------------------
# Przypnij wersję, żeby wszystkie instancje miały tę samą i nie zmieniały się
# przy kolejnym `docker compose up` (puste = latest, odradzane na szkolenie).
# Sprawdź bieżącą:  docker exec n8n-user1 n8n --version
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.20.11

# Kanał, którym edytor dostaje postęp wykonania. `websocket` (domyślny) albo
# `sse` — Server-Sent Events, zwykłe HTTP z ciasteczkiem; użyj, gdy edytor
# pokazuje "Lost connection to the server", a /rest/push zwraca 401 lub
# jest cięty przez proxy/VPN uczestników.
N8N_PUSH_BACKEND=websocket

# --- Publiczne IP serwera (opcjonalne) ----------------------------------------
# Używane przez preflight.sh do weryfikacji DNS. Puste = wykrywane automatycznie.
SERVER_IP=

# =============================================================================
# Szybkie wygenerowanie silnych haseł do wklejenia powyżej:
#   openssl rand -hex 16
# =============================================================================
